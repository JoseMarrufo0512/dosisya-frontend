{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/ssr.js": {
      "includeFiles": "dist/server/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://proyecto-dosis-ya.vercel.app/api/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/api/ssr" }
  ]
}
