{
  "permissions": {
    "allow": [
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Preview__preview_console_logs",
      "mcp__Claude_Preview__preview_snapshot",
      "mcp__Claude_Preview__preview_network",
      "mcp__Claude_Preview__preview_logs",
      "mcp__Claude_Preview__preview_list",
      "mcp__Claude_Preview__preview_inspect",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__find"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx) cd \"$CLAUDE_PROJECT_DIR\" && out=$(npx tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo 2>&1) || { { echo \"tsc --noEmit detectó errores de tipos tras editar $f:\"; echo \"$out\"; } >&2; exit 2; };; esac",
            "asyncRewake": true,
            "timeout": 120,
            "statusMessage": "Verificando tipos (tsc --noEmit)..."
          }
        ]
      }
    ]
  }
}
