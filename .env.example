# Base del backend para el SSR (servidor). El NAVEGADOR ya NO la usa: llama a
# rutas relativas /api/v1/* que Vercel (vercel.json) reenvía al backend, para
# evitar que adblockers/escudos de privacidad bloqueen la petición cross-site.
# En dev puede quedar vacía: el proxy de Vite atiende /api → localhost:8000.
VITE_API_URL=https://tu-api.vercel.app

# Monitoreo de errores (Sentry). Vacío = SDK inactivo (no-op).
VITE_SENTRY_DSN=
SENTRY_DSN=
# Solo necesarios para subir source maps en el build (opcional):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Analítica de funnel (PostHog). Vacío = SDK inactivo (no-op).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
